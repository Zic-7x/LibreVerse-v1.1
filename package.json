{
  "name": "platform-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "admin",
    "backend",
    "mobile",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @platform/shared-types && npm run build -w @platform/domain-core && npm run build -w @platform/backend && npm run build -w @platform/mobile && npm run build -w @platform/admin",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "db:migrate": "node database/scripts/migrate.mjs",
    "dev": "npm run dev -w @platform/backend",
    "dev:backend": "npm run dev -w @platform/backend"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@types/ws": "^8.18.1",
    "eslint": "^9.28.0",
    "globals": "^16.2.0",
    "pg": "^8.16.0",
    "typescript-eslint": "^8.33.0"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/websocket": "^11.3.0",
    "@supabase/supabase-js": "^2.112.1",
    "ws": "^8.21.1"
  }
}
